type Query {
  adminUsers: [AdminUser!]!
  adminStats: AdminStats!

  myProfile: Profile!
  currentPlan: TrainingPlan!
}

type Mutation {
  deleteUser(id: ID!): DeletedUser
}

type AdminUser {
  userId: ID!
  name: String!
  email: String!
  registeredAt: String!
  role: String!
}

type AdminStats {
  users: Int!
  plans: Int!
  marksLastSevenDays: Int!
}

type DeletedUser {
  message: String!
  userId: ID!
}

type Profile {
  profileId: ID!
  personal: Personal!
  training: Training!
  createdAt: String!
  updatedAt: String!
  planExists: Boolean!
  nextPlanFrom: String
}

type Personal {
  age: Int!
  gender: String!
  height: Int!
  weight: Float!
}

type Training {
  goal: String!
  fitnessLevel: String!
  trainingDays: [String!]!
}

type TrainingPlan {
  planId: ID!
  weekStart: String!
  weekEnd: String!
  today: String!
  exerciseDataAvailable: Boolean!
  sessions: [TrainingSession!]!
}

type TrainingSession {
  sessionId: ID!
  label: String!
  date: String!
  status: String!
  available: Boolean!
  carried: Boolean!
  exercises: [PlanExercise!]!
}

type PlanExercise {
  planExerciseId: ID!
  exerciseId: String!
  name: String
  bodyPart: String!
  targetMuscle: String
  equipment: String
  imageUrl: String
  sets: Int!
  reps: String!
  weight: Float
  bodyweight: Boolean!
  mark: ExerciseMark
}

# KI-Log Nr. 32: Istwerte werden nicht mehr erfasst; Felder bleiben für bestehende Abfragen
type ExerciseMark {
  id: ID!
  date: String!
  done: Boolean!
  weight: Float @deprecated(reason: "Actual values are no longer recorded. Always null.")
  reps: Int! @deprecated(reason: "Actual values are no longer recorded. Always 0.")
  automatic: Boolean!
}